# Optional overrides for local development / Docker Compose.
POSTGRES_PASSWORD=lifeos_dev
# Set true only when the API is served over HTTPS.
COOKIE_SECURE=false

# Local-only demo account. The Admin account is not created in production.
LIFEOS_LOCAL_DEMO=true
LIFEOS_DEMO_PASSWORD=1234

# Optional Google OAuth. Register this exact callback URL in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
APP_BASE_URL=http://localhost:5173

# Optional SMTP settings for warm welcome and sign-in emails.
SMTP_URL=
EMAIL_FROM=Life OS <no-reply@example.com>

# Optional Stripe subscription billing for Life OS Plus.
# Create monthly (£3.99) and yearly (£29.99) recurring prices in Stripe,
# then set their Price IDs and configure a webhook for /api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_YEARLY_ID=
